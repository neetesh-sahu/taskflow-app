function App() {
  const [authPage, setAuthPage] =
    useState("Landing");

  const [page, setPage] =
    useState("Dashboard");

  const [token, setToken] = useState(
    () => localStorage.getItem(TOKEN_KEY)
  );

  const [user, setUser] = useState(null);
  const [tasks, setTasks] = useState([]);

  const [loading, setLoading] = useState(false);
  const [taskLoading, setTaskLoading] =
    useState(false);

  const [mobileOpen, setMobileOpen] =
    useState(false);

  const [search, setSearch] = useState("");

  const [taskModal, setTaskModal] =
    useState(null);

  const [inviteModal, setInviteModal] =
    useState(false);

  const [theme, setThemeState] = useState(
    () =>
      localStorage.getItem(THEME_KEY) ||
      "light"
  );

  const [toast, setToast] = useState(null);

  const [members, setMembers] =
    useState(initialMembers);

  const [invitations, setInvitations] =
    useState([]);

  const [team, setTeam] = useState(null);
  const [teamLoading, setTeamLoading] =
    useState(false);

  const showToast = (
    message,
    type = "success",
    title = "TaskFlow"
  ) => {
    setToast({
      message,
      type,
      title,
    });

    setTimeout(() => {
      setToast(null);
    }, 3500);
  };

  const setTheme = (newTheme) => {
    setThemeState(newTheme);
    localStorage.setItem(
      THEME_KEY,
      newTheme
    );
  };

  useEffect(() => {
    document.documentElement.setAttribute(
      "data-theme",
      theme
    );
  }, [theme]);

  useEffect(() => {
    if (!token) return;

    loadApplication();
  }, [token]);

  const loadApplication = async () => {
    try {
      setLoading(true);

      const profile = await getProfile(token);
      setUser(profile.user || profile);

      const taskResponse = await getTasks(token);

      const serverTasks =
        taskResponse.tasks ||
        taskResponse.data ||
        [];

      setTasks(serverTasks.map(normalizeTask));

      // Team Service is independent from the core application.
      // If it is unavailable, keep the user logged in and show an empty team.
      try {
        setTeamLoading(true);

        const teamResponse = await getTeams(token);
        let teams = teamResponse.teams || teamResponse.data || [];

        let currentTeam = teams[0] || null;

        // Create the first workspace automatically for a new account.
        if (!currentTeam) {
          const created = await createTeam(token, {
            name: "TaskFlow Team",
          });

          currentTeam =
            created.team ||
            created.data?.team ||
            null;
        }

        setTeam(currentTeam);

        if (currentTeam?.id) {
          const memberResponse = await getTeamMembers(
            token,
            currentTeam.id
          );

          const serverMembers =
            memberResponse.members ||
            memberResponse.data ||
            [];

          setMembers(
            serverMembers.map((member) => ({
              id: member.user_id || member.id,
              name: member.name || "Team Member",
              email: member.email || "",
              role: capitalize(member.role || "member"),
              status: "online",
              initials: (member.name || "TM")
                .split(" ")
                .map((part) => part[0])
                .join("")
                .slice(0, 2)
                .toUpperCase(),
            }))
          );
        } else {
          setMembers([]);
        }
      } catch (teamError) {
        console.error(
          "[TaskFlow] Team Service error:",
          teamError
        );
        setTeam(null);
        setMembers([]);
      } finally {
        setTeamLoading(false);
      }

      setAuthPage("App");
    } catch (error) {
      console.error(
        "[TaskFlow] Application load error:",
        error
      );

      // Only clear the session for an authentication failure.
      if (
        /401|403|invalid|expired|authentication|token/i.test(
          error.message || ""
        )
      ) {
        localStorage.removeItem(TOKEN_KEY);
        setToken(null);
        setUser(null);
        setTasks([]);

        showToast(
          "Your session expired. Please login again.",
          "error",
          "Session expired"
        );
      } else {
        showToast(
          error.message ||
            "Unable to load your workspace.",
          "error",
          "Workspace error"
        );
      }
    } finally {
      setLoading(false);
    }
  };

  const handleAuth = async (credentials) => {
    try {
      setLoading(true);

      const response =
        credentials.type === "signup"
          ? await signup({
              name: credentials.name,
              email: credentials.email,
              password: credentials.password,
            })
          : await login({
              email: credentials.email,
              password: credentials.password,
            });

      const newToken = response.token;

      localStorage.setItem(
        TOKEN_KEY,
        newToken
      );

      setToken(newToken);
      setUser(response.user);

      showToast(
        credentials.type === "signup"
          ? "Your TaskFlow account has been created."
          : "Welcome back to your workspace.",
        "success",
        credentials.type === "signup"
          ? "Account created"
          : "Login successful"
      );

      setAuthPage("App");
      setPage("Dashboard");
    } catch (error) {
      showToast(
        error.message || "Authentication failed.",
        "error",
        "Authentication error"
      );
    } finally {
      setLoading(false);
    }
  };

  const logout = () => {
    localStorage.removeItem(TOKEN_KEY);
    setToken(null);
    setUser(null);
    setTasks([]);
    setAuthPage("Landing");
    setPage("Dashboard");

    showToast(
      "You have been logged out.",
      "info",
      "Logged out"
    );
  };

  const refreshTasks = async () => {
    const response = await getTasks(token);

    const serverTasks =
      response.tasks ||
      response.data ||
      [];

    setTasks(serverTasks.map(normalizeTask));
  };

  const saveTask = async (taskData) => {
    try {
      setTaskLoading(true);

      if (taskModal?.mode === "edit") {
        await updateTask(
          token,
          taskModal.task.id,
          taskData
        );

        showToast(
          "Task updated successfully.",
          "success",
          "Task updated"
        );
      } else {
        await createTask(token, taskData);

        showToast(
          "New task created successfully.",
          "success",
          "Task created"
        );
      }

      await refreshTasks();

      setTaskModal(null);
    } catch (error) {
      showToast(
        error.message || "Unable to save task.",
        "error",
        "Task error"
      );
    } finally {
      setTaskLoading(false);
    }
  };

  const removeTask = async (task) => {
    const confirmed = window.confirm(
      `Delete "${task.title}"?`
    );

    if (!confirmed) return;

    try {
      await deleteTask(token, task.id);

      setTasks((current) =>
        current.filter(
          (item) => item.id !== task.id
        )
      );

      showToast(
        "Task deleted successfully.",
        "success",
        "Task deleted"
      );
    } catch (error) {
      showToast(
        error.message || "Unable to delete task.",
        "error",
        "Delete failed"
      );
    }
  };

  const toggleTask = async (task) => {
    const nextStatus =
      task.status === "Completed"
        ? "pending"
        : "completed";

    try {
      await updateTask(token, task.id, {
        title: task.title,
        description: task.description,
        priority: task.priority.toLowerCase(),
        status: nextStatus,
        due_date: task.due_date || null,
      });

      setTasks((current) =>
        current.map((item) =>
          item.id === task.id
            ? {
                ...item,
                status:
                  nextStatus === "completed"
                    ? "Completed"
                    : "Pending",
              }
            : item
        )
      );
    } catch (error) {
      showToast(
        error.message || "Unable to update task.",
        "error",
        "Task error"
      );
    }
  };

  const saveProfile = async (profileData) => {
    try {
      const response = await updateProfile(
        token,
        profileData
      );

      const updatedUser =
        response.user || response;

      setUser(updatedUser);

      showToast(
        "Profile updated successfully.",
        "success",
        "Profile saved"
      );
    } catch (error) {
      showToast(
        error.message || "Unable to update profile.",
        "error",
        "Profile error"
      );
    }
  };

  const inviteMember = async ({ email, role }) => {
    if (!team?.id) {
      showToast(
        "Your team workspace is not ready yet.",
        "error",
        "Team unavailable"
      );
      return;
    }

    try {
      setLoading(true);

      const response = await createInvitation(
        token,
        team.id,
        { email: email.trim().toLowerCase() }
      );

      const invitation = response.invitation || {};

      const newInvitation = {
        id: invitation.id || Date.now(),
        email: invitation.email || email,
        role,
        date: invitation.expiresAt
          ? `Expires ${formatDate(invitation.expiresAt)}`
          : "Pending",
        inviteUrl: response.inviteUrl || "",
      };

      setInvitations((current) => [
        newInvitation,
        ...current,
      ]);

      setInviteModal(false);

      showToast(
        response.inviteUrl
          ? `Invitation created for ${email}. Invite link is ready.`
          : `Invitation created for ${email}.`,
        "success",
        "Invitation created"
      );

      if (response.inviteUrl) {
        console.log(
          "[TaskFlow] Invite URL:",
          response.inviteUrl
        );
      }
    } catch (error) {
      console.error(
        "[TaskFlow] Invitation error:",
        error
      );

      showToast(
        error.message ||
          "Unable to create invitation.",
        "error",
        "Invitation failed"
      );
    } finally {
      setLoading(false);
    }
  };

  const cancelInvitation = (id) => {
    setInvitations((current) =>
      current.filter(
        (invite) => invite.id !== id
      )
    );

    showToast(
      "Invitation cancelled.",
      "info",
      "Invitation cancelled"
    );
  };

  const openTaskModal = (task = null) => {
    setTaskModal(
      task
        ? {
            mode: "edit",
            task,
          }
        : {
            mode: "create",
            task: null,
          }
    );
  };

  if (authPage === "Landing" && !token) {
    return (
      <>
        <LandingPage setAuthPage={setAuthPage} />
        <Toast
          toast={toast}
          onClose={() => setToast(null)}
        />
      </>
    );
  }

  if (
    (authPage === "Login" ||
      authPage === "Signup") &&
    !token
  ) {
    return (
      <>
        <AuthPage
          type={authPage}
          setAuthPage={setAuthPage}
          onAuth={handleAuth}
          loading={loading}
        />

        <Toast
          toast={toast}
          onClose={() => setToast(null)}
        />
      </>
    );
  }

  let content = null;

  if (page === "Dashboard") {
    content = (
      <Dashboard
        tasks={tasks}
        setPage={setPage}
        openTaskModal={openTaskModal}
        onToggle={toggleTask}
      />
    );
  }

  if (page === "My Tasks") {
    content = (
      <TasksPage
        tasks={tasks}
        search={search}
        openTaskModal={openTaskModal}
        onToggle={toggleTask}
        onEdit={openTaskModal}
        onDelete={removeTask}
      />
    );
  }

  if (page === "Calendar") {
    content = <CalendarPage tasks={tasks} />;
  }

  if (page === "Analytics") {
    content = <AnalyticsPage tasks={tasks} />;
  }

  if (page === "Team") {
    content = (
      <TeamPage
        team={team}
        members={members}
        invitations={invitations}
        openInvite={() => setInviteModal(true)}
        onCancelInvite={cancelInvitation}
      />
    );
  }

  if (page === "Settings") {
    content = (
      <SettingsPage
        user={user}
        theme={theme}
        setTheme={setTheme}
        onProfileUpdate={saveProfile}
      />
    );
  }

  return (
    <div className="tf-app">
      <div className="background-grid" />
      <div className="background-glow glow-one" />
      <div className="background-glow glow-two" />

      <Sidebar
        page={page}
        setPage={setPage}
        mobileOpen={mobileOpen}
        setMobileOpen={setMobileOpen}
        user={user}
        onLogout={logout}
      />

      <main className="tf-main">
        <Topbar
          onMenu={() => setMobileOpen(true)}
          search={search}
          setSearch={setSearch}
          theme={theme}
          setTheme={setTheme}
          user={user}
          onLogout={logout}
        />

        {content}
      </main>

      {taskModal && (
        <TaskModal
          task={taskModal.task}
          onClose={() => setTaskModal(null)}
          onSave={saveTask}
          loading={taskLoading}
        />
      )}

      {inviteModal && (
        <InviteModal
          onClose={() => setInviteModal(false)}
          onInvite={inviteMember}
          loading={loading}
        />
      )}

      <Toast
        toast={toast}
        onClose={() => setToast(null)}
      />
    </div>
  );
}

export default App;